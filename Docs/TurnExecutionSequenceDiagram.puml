@startuml
' THIẾT LẬP GIAO DIỆN
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center

actor "Người chơi" as Player
participant "BattleManager" as BM
participant "EnemyWaveManager" as EWM
participant "CardBattle (Địch)" as Enemy
participant "CardBattle (Người chơi)" as Ally
participant "ElementalHandler" as Elem

Player -> BM: Bấm nút "Kết thúc lượt" (EndTurn)
activate BM

BM -> EWM: OnTurnStart() (Kiểm tra Quái mới)
activate EWM
EWM --> BM: 
deactivate EWM

BM -> BM: Tính toán GlobalAnimationSpeed

== Pha 1: Kẻ địch Tấn công ==
loop Từng Kẻ địch
    BM -> Enemy: OnTurnTickRoutine()
    activate Enemy
    
    Enemy -> Elem: TriggerTurnStart()
    activate Elem
    Elem -> Elem: Kiểm tra Băng (Khóa tốc độ)
    Elem -> Elem: Kiểm tra Sét (Nổ Chain lan truyền)
    Elem --> Enemy: 
    deactivate Elem
    
    Enemy -> Enemy: Thực hiện Tấn công (Nếu không bị đóng băng)
    
    Enemy -> Elem: TriggerTurnEnd()
    activate Elem
    Elem -> Elem: Kiểm tra Phân rã (Nổ sát thương Decay)
    Elem --> Enemy: 
    deactivate Elem
    
    Enemy --> BM: Hoàn tất lượt
    deactivate Enemy
end

== Pha 2: Đồng minh Tấn công ==
loop Từng Tướng (Đồng minh)
    BM -> Ally: OnTurnTickRoutine()
    activate Ally
    Ally -> Ally: Tính toán Tốc độ & Tấn công
    Ally --> BM: Hoàn tất lượt
    deactivate Ally
end

== Pha 3: Nguyên tố Hậu kỳ ==
loop Từng Kẻ địch
    BM -> Elem: TriggerAfterPlayerAction()
    activate Elem
    Elem -> Elem: Nổ Chảy máu (Gây sát thương = Sát thương vật lý đã nhận)
    Elem --> BM: 
    deactivate Elem
end

BM --> Player: Mở khóa tương tác (Bắt đầu lượt mới)
deactivate BM

@enduml
