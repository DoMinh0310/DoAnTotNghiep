@startuml
' THIẾT LẬP GIAO DIỆN
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial
skinparam conditionStyle diamond

start
:Trình Quản lý Nguyên tố (Elemental Handler) nhận tín hiệu;

if (Đang ở Thời điểm nào?) then (Trước khi Địch Tấn công\nTurnStart)
  
  if (Đang có Băng (Frost)?) then (Có Stack)
    :Tốc độ (Speed) bị Đóng băng không thể hành động;
    :Giảm 1 Stack Băng;
  else (Không)
  endif
  
  if (Đang có Sét (Chain)?) then (Stack Sét >= HP Hiện tại)
    :Kích nổ Sét (Chain Explosion);
    :Gây sát thương bằng số Stack Sét lên mục tiêu chính;
    :Reset Stack Sét về 0;
    :Lan truyền 1/2 sát thương (làm tròn xuống) cho các Kẻ địch cùng hàng;
    :Lây nhiễm 1 Stack của toàn bộ Nguyên tố mục tiêu đang có\ncho các Kẻ địch cùng hàng;
  else (Chưa đủ HP)
  endif

elseif (Sau tất cả Lượt của Người chơi\nAfterPlayerAction)
  
  if (Đang có Chảy máu (Bleed)?) then (Có đòn Vật lý đánh trúng)
    :Kích nổ Chảy máu;
    :Gây sát thương Nguyên tố = Tổng sát thương vật lý vừa nhận trong lượt;
    :Reset Stack Chảy máu và Sát thương chờ (Pending) về 0;
  else (Không bị đánh)
  endif

else (Sau khi Địch Tấn công xong\nTurnEnd)
  
  if (Đang có Phân rã (Decay)?) then (Có Stack)
    :Gây sát thương = Số Stack Phân rã hiện tại;
    :Tăng số Stack Phân rã thêm 1 (Leo thang sát thương liên tục);
  else (Không)
  endif

endif

:Tính toán Giảm trừ Kháng nguyên tố;
:Trừ Sinh lực (HP) và cập nhật Giao diện (VFX/UI);
stop
@enduml
