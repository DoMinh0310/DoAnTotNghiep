@startuml
' THIẾT LẬP GIAO DIỆN (Đồng nhất phong cách đen trắng)
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial

skinparam activity {
    BackgroundColor White
    BorderColor Black
    FontColor Black
}

skinparam conditionStyle diamond

start

:Bắt đầu trò chơi;
:Khởi tạo Nhân vật và Bộ bài cơ bản;

repeat :Hiển thị Bản đồ;
  :Người chơi chọn Điểm đến (Node) tiếp theo;
  
  if (Loại Điểm đến là gì?) then (Chiến đấu)
    :Chuyển sang màn hình Chiến đấu;
    :Khởi tạo các đợt Kẻ địch (Enemy Waves);
    
    repeat :Bắt đầu Lượt của Người chơi;
      :Hệ thống phát thẻ bài lên tay;
      
      while (Hành động) is (Chọn và đánh bài)
        :Kéo thả thẻ bài lên mục tiêu;
        :Thực thi Kỹ năng thẻ bài;
        :Kiểm tra và kích hoạt Hiệu ứng Nguyên tố;
      endwhile (Chọn "Kết thúc lượt")
      
      if (Tất cả Kẻ địch bị tiêu diệt?) then (Chưa)
        :Bắt đầu Lượt của Kẻ địch;
        :Kẻ địch Tấn công / Thi triển chiêu thức;
        
        if (Máu của Người chơi <= 0?) then (Đúng)
          :Màn hình Thất bại (Game Over);
          stop
        else (Sai)
        endif
        
      else (Đã tiêu diệt hết)
      endif
      
    repeat while (Trận đấu kết thúc chưa?) is (Chưa)
    -> Trận đấu kết thúc (Chiến thắng);
    
    :Hiển thị Màn hình Phần thưởng;
    :Nhận Vàng vào túi đồ;
    :Chọn thẻ bài thưởng hoặc Cổ vật;
    
  else (Sự kiện / Điểm dừng chân)
    :Chuyển sang cảnh Sự kiện;
    :Người chơi tương tác / Lựa chọn;
    :Nhận lợi ích hoặc chịu hình phạt;
  endif
  
repeat while (Đã đánh bại Boss cuối của Bản đồ?) is (Chưa)
-> Đã đánh bại Boss;

:Màn hình Chiến thắng hành trình (Victory);
stop

@enduml
