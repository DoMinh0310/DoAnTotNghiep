@startuml
skinparam shadowing false
skinparam monochrome true
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial

interface IElementalEffect {
    + void ApplyStack(int amount)
    + int GetStack()
    + void ClearStack()
    + IEnumerator OnTurnStart()
    + IEnumerator OnTurnEnd()
    + IEnumerator OnAfterPlayerAction()
    + IEnumerator OnReceivePhysicalDamage(int amount)
}

class ElementalHandler {
    - Dictionary<ElementType, IElementalEffect> activeEffects
    + void ApplyElement(ElementType, int)
    + IEnumerator TriggerTurnStart()
    + IEnumerator TriggerTurnEnd()
}

class FrostEffect {
    - int currentStacks
    + void ApplyStack(int)
    + IEnumerator OnTurnStart()
    + int GetSpeedModifier()
}

class BleedEffect {
    - int currentStacks
    - int accumulatedDamage
    + void ApplyStack(int)
    + IEnumerator OnReceivePhysicalDamage(int)
    + IEnumerator OnAfterPlayerAction()
}

class DecayEffect {
    - int currentStacks
    + void ApplyStack(int)
    + IEnumerator OnTurnEnd()
}

class ChainEffect {
    - int currentStacks
    + void ApplyStack(int)
    + IEnumerator OnTurnStart()
}

IElementalEffect <|.. FrostEffect
IElementalEffect <|.. BleedEffect
IElementalEffect <|.. DecayEffect
IElementalEffect <|.. ChainEffect

ElementalHandler o-- IElementalEffect : Quản lý danh sách >

@enduml
