@startuml
skinparam shadowing false
skinparam monochrome true
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial

title Biểu đồ Lớp: Hệ thống Tương tác UI (UI Interaction & EventSystems)

interface IBeginDragHandler
interface IDragHandler
interface IEndDragHandler
interface IDropHandler
interface IPointerEnterHandler
interface IPointerClickHandler

class SkillDragHandler {
    + void OnBeginDrag()
    + void OnDrag()
    + void OnEndDrag()
    - void UpdateTargetingCurve()
    - void ActivateSkill(CardBattle)
}

class RelicSlotUI {
    + RelicData currentRelic
    + int championIndex
    + void OnBeginDrag()
    + void OnDrag()
    + void OnEndDrag()
    + void OnDrop()
    + void OnPointerClick()
}

class TrinketSlotUI {
    + TrinketData currentTrinket
    + void OnPointerEnter()
    + void OnPointerExit()
}

IBeginDragHandler <|.. SkillDragHandler
IDragHandler <|.. SkillDragHandler
IEndDragHandler <|.. SkillDragHandler

IBeginDragHandler <|.. RelicSlotUI
IDragHandler <|.. RelicSlotUI
IEndDragHandler <|.. RelicSlotUI
IDropHandler <|.. RelicSlotUI
IPointerClickHandler <|.. RelicSlotUI

IPointerEnterHandler <|.. TrinketSlotUI

@enduml
