@startuml
skinparam shadowing false
skinparam monochrome true
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial

title Biểu đồ Lớp: Kiến trúc Quản lý (Singleton Managers)

class GameManager {
    + {static} GameManager Instance
    + MapRunData RunData
    + void StartNewRun()
    + void SaveGame()
    + void LoadMapScene()
    + void LoadBattleScene()
}

class BattleManager {
    + {static} BattleManager Instance
    + bool IsPreparationPhase
    + void EndTurn(bool)
    - IEnumerator ProcessTurn()
}

class MapManager {
    + {static} MapManager Instance
    + bool IsEventInProgress
    + void MoveToNode(MapSlotDefinition)
    - void TriggerNodeEvent(NodeType)
}

class InventoryManager {
    + {static} InventoryManager Instance
    + void OpenInventory()
    + void CloseInventory()
    + void HandleRelicDrop(RelicSlotUI, RelicSlotUI)
}

GameManager <-- BattleManager : Giao tiếp & Load Dữ liệu >
GameManager <-- MapManager : Lưu RunData trước khi Combat >
GameManager <-- InventoryManager : Cập nhật Trang bị >

note right of GameManager
  Tồn tại xuyên suốt các Scene 
  (DontDestroyOnLoad)
end note

@enduml
