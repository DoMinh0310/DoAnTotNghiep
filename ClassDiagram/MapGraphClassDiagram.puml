@startuml
skinparam shadowing false
skinparam monochrome true
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial

class MapRunData {
    + int seed
    + int currentDepth
    + int currentSlotIndex
    + List<int> pathTaken
}

class MapManager {
    - MapRunData currentRun
    - MapSlotDefinition[] allSlots
    + void GenerateMap()
    + void RevealAvailableNodes()
    + void MoveToNode(MapSlotDefinition)
}

class MapSlotDefinition {
    + int slotIndex
    + int depth
    + NodeType nodeType
    + List<int> nextSlots
    + Vector2 uiPosition
}

class MapNode {
    + MapSlotDefinition slotData
    + void SetState(NodeState)
    + void OnPointerClick()
}

class UIMapLine {
    + void DrawLine(Vector2, Vector2)
    + void SetColor(Color)
}

MapRunData <-- MapManager : Quản lý trạng thái lưu >
MapManager *-- MapSlotDefinition : Lưu danh sách tất cả Node (Graph) >
MapNode --> MapSlotDefinition : Hiển thị UI cho Node >
MapManager --> UIMapLine : Vẽ đường nối giữa các Node >
MapSlotDefinition --> MapSlotDefinition : Mảng nextSlots liên kết (DAG) >

@enduml
