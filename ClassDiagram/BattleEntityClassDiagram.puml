@startuml
skinparam shadowing false
skinparam monochrome true
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial

class MonoBehaviour {
}

class CardBattle {
    + CardData CardData
    + int CurrentHP
    + int CurrentArmor
    + int CurrentSpeed
    + bool IsDead
    + void TakeDamage(int, bool)
    + void Heal(int)
    + void AddArmor(int)
    + IEnumerator OnTurnTickRoutine()
}

class RelicHandler {
    - RelicData currentRelic
    - int countdown
    + void EquipRelic(RelicData)
    + void OnBellPressed()
    - void FireRelicSkill()
}

class TrinketHandler {
    - TrinketData currentTrinket
    + void EquipTrinket(TrinketData)
    + int GetHPBonus()
    + int GetSpeedBonus()
}

class ElementalHandler {
    + void ApplyElement(ElementType, int)
    + IEnumerator TriggerTurnStart()
    + IEnumerator TriggerTurnEnd()
    + IEnumerator TriggerAfterPlayerAction()
}

MonoBehaviour <|-- CardBattle
MonoBehaviour <|-- RelicHandler
MonoBehaviour <|-- TrinketHandler
MonoBehaviour <|-- ElementalHandler

CardBattle *-- RelicHandler : Chứa component >
CardBattle *-- TrinketHandler : Chứa component >
CardBattle *-- ElementalHandler : Chứa component >

@enduml
