@startuml
' THIẾT LẬP GIAO DIỆN
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial
skinparam conditionStyle diamond
skinparam defaultFontSize 16
skinparam wrapWidth 220

start
:Người chơi mở Túi đồ (Inventory);
:Phát Hoạt ảnh Vòng tròn mở rộng (Circle Reveal);
:Tải toàn bộ dữ liệu Tướng, Thẻ bài, Cổ vật, Phụ kiện;

while (Đang ở trong Túi đồ?) is (Có)
  :Người chơi thao tác;
  
  if (Thao tác là gì?) then (Xem Bộ bài & Phụ kiện)
    :Xem chi tiết Thẻ bài và Kỹ năng hỗ trợ;
    :Di chuột (Hover) vào Phụ kiện (Trinket)\nđể xem thông tin (Chỉ đọc, không thể tháo lắp);
    
  elseif (Trang bị / Đổi Cổ vật (Kéo thả))
    if (Đang trong Trận chiến?) then (Có)
      :Khóa thao tác (Combat Lock);
    else
      :Kéo lê Cổ vật từ Túi hoặc từ Tướng khác;
      if (Vị trí thả hợp lệ?) then (Có)
        :Cập nhật Cổ vật vào Tướng;
        :Hoán đổi (Swap) nếu Tướng đã có Cổ vật khác;
        :Cập nhật Kỹ năng Chủ động từ Cổ vật;
      else (Không hợp lệ)
        :Trả Cổ vật về vị trí cũ;
      endif
    endif
    
  else (Tháo Cổ vật (Click Chuột phải))
    if (Đang trong Trận chiến?) then (Có)
      :Khóa thao tác (Combat Lock);
    else (Không)
      :Tháo Cổ vật khỏi Tướng;
      :Đưa Cổ vật về Lưới lưu trữ bên trái (Sidebar);
    endif
  endif
  
endwhile (Đóng Túi đồ)

:Phát Hoạt ảnh Vòng tròn thu hẹp;
:Xóa dữ liệu hiển thị (Clear Inventory);
stop
@enduml
